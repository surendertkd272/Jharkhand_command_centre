# ============================================================================
# Physiological-monitoring integrations. Copy to `.env.local` and fill in once
# you have vendor access. If these are UNSET the app runs in DEMO mode (the
# adapters return deterministic sample data). Setting them flips a source LIVE.
# See docs/INTEGRATIONS.md for how to obtain access + what each field means.
# ============================================================================

# --- Firstbeat (Firstbeat Sports Cloud / Garmin Health API) ---
# Leave FIRSTBEAT_API_BASE empty to stay in demo mode.
FIRSTBEAT_API_BASE=
FIRSTBEAT_CLIENT_ID=
FIRSTBEAT_CLIENT_SECRET=
# FIRSTBEAT_TEAM_ID=

# --- Myoact (EMG muscle-activity monitoring) ---
# Leave MYOACT_API_BASE empty to stay in demo mode.
MYOACT_API_BASE=
MYOACT_API_KEY=
